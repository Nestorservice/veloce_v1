# API Groq (Architecte - LLaMA 3.3-70B, 131K contexte)
# Clé gratuite sur : https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_ENDPOINT=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# API DeepSeek (Ouvrier - V4-Flash, 1M contexte, fallback sur 429 Groq)
# Clé gratuite a l'inscription sur : https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-v4-flash

# Chemins projet
PHP_SOURCE_PATH=C:\chemin\vers\projet-laravel
MIRROR_WORK_PATH=C:\veloce-workdir

# Parametres pipeline
BATCH_SIZE=15
MAX_RETRY_COMPILE=3
SLEEP_BETWEEN_FILES=10
FILES_BEFORE_CLEANUP=50
CPU_CORES_LIMIT=2
